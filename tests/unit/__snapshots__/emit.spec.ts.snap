exports[`emit(MeasuredTree) snapshot is stable for a representative two-block layout 1`] = `
<table id="root" role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; width: 100%; max-width: 600px;">
  <tbody>
    <tr>
      <td valign="middle">
        <div id="title" style="font-size: 32px; color: rgb(17, 17, 17);">What's New?</div>
      </td>
    </tr>
    <tr>
      <td height="40" style="font-size: 1px; line-height: 1px;">&nbsp;</td>
    </tr>
    <tr>
      <td align="center" valign="top"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://example.com" style="height:44px;v-text-anchor:middle;width:200px;" arcsize="14%" strokecolor="#007aff" fillcolor="#007aff"><w:anchorlock/><center style="color: #fffffe;">Read more</center></v:roundrect><![endif]--><!--[if !mso]><!--><a id="cta" href="https://example.com" style="display: inline-block; background-color: rgb(0, 122, 255); color: #fffffe; border-radius: 6px; text-decoration: none;">Read more</a><!--<![endif]--></td>
    </tr>
  </tbody>
</table>
`;
